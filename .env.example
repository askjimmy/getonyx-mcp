# Copy to .env and adjust. All values are optional — defaults are used when unset.

# Keystore location (encrypted private keys of local wallets: solana, bsc, arbitrum)
WALLET_KEYSTORE_PATH=/home/you/.config/wallet-mcp-server/keystore.json

# RPC endpoints
AMBIENT_RPC_URL=https://rpc.ambient.xyz
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BSC_RPC_URL=https://bsc-dataseed.binance.org/
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Dynamic (online wallet for the Ambient chain)
DYNAMIC_ENVIRONMENT_ID=a9e7161d-c693-44be-8183-2c104ec7264e
# Dynamic session storage path
DYNAMIC_SESSION_PATH=/home/you/.config/wallet-mcp-server/dynamic-session.json
# Password used to encrypt the Dynamic session file at rest (JWT + session key).
# Falls back to WALLET_PASSWORD. Without either, the session file is written in
# plaintext with 0600 permissions.
DYNAMIC_SESSION_PASSWORD=
# Password of the Dynamic wallet key-share backup. Required when the Ambient
# wallet is created with a backup password; the wallet cannot be recovered
# without it.
WALLET_PASSWORD=
# Chain identifier reported to Dynamic when signing Ambient (SVM) transactions.
AMBIENT_CHAIN_ID=mainnet-beta
# Set to 1 to skip preflight simulation when broadcasting to Ambient.
AMBIENT_SKIP_PREFLIGHT=
