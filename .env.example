# Copy to .env and adjust. All values are optional — defaults are used when unset.

# Keystore location (encrypted private keys)
WALLET_KEYSTORE_PATH=/home/you/.config/wallet-mcp-server/keystore.json

# RPC endpoints
AMBIENT_RPC_URL=https://rpc.ambient.xyz
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BSC_RPC_URL=https://bsc-dataseed.binance.org/
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Dynamic (for Ambient online wallet)
DYNAMIC_ENVIRONMENT_ID=a9e7161d-c693-44be-8183-2c104ec7264e
DYNAMIC_AUTH_TOKEN=
SESSION_PRIVATE_KEY_JWK=
DYNAMIC_JWT=
WALLET_PASSWORD=
# Dynamic session storage path
DYNAMIC_SESSION_PATH=/home/you/.config/wallet-mcp-server/dynamic-session.json

