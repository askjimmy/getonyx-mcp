{
  "name": "wallet-mcp-server",
  "version": "0.1.0",
  "description": "Multi-chain wallet MCP server for the GetOnyx DEX stack (Ambient via the Dynamic online wallet, plus local Solana, BSC and Arbitrum One keys) — key management, signing and broadcasting",
  "type": "module",
  "license": "MIT",
  "author": "GetOnyx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askjimmy/getonyx-mcp.git"
  },
  "homepage": "https://github.com/askjimmy/getonyx-mcp#readme",
  "bugs": {
    "url": "https://github.com/askjimmy/getonyx-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wallet",
    "getonyx",
    "ambient",
    "solana",
    "bsc",
    "arbitrum",
    "crypto"
  ],
  "main": "./dist/index.js",
  "bin": {
    "wallet-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts --ext ts --quiet",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@dynamic-labs-wallet/node": "^1.1.48",
    "@dynamic-labs-wallet/node-svm": "^1.1.48",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@noble/curves": "^1.0.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^9.1.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3"
  }
}
